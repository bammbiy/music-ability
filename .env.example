SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:3003/callback
# 32자 이상 무작위 값 (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change_this_to_a_long_random_string
# 선택: 사용자 ID 익명화용 키. 비우면 SESSION_SECRET을 사용
USER_HASH_SECRET=
PORT=3003
APPLE_MUSICKIT_DEVELOPER_TOKEN=your_apple_music_developer_token
YOUTUBE_API_KEY=your_youtube_data_api_key
NEWS_RSS_URLS=
SOCIAL_FEED_URLS=
# 평단/청취자 평가 수집 (공식·공개 API만 사용)
ACCLAIM_ENABLED=1
# MusicBrainz 이용 규칙상 연락처(이메일 또는 URL)를 User-Agent에 넣어야 해요
ACCLAIM_CONTACT=
# 선택: Discogs 커뮤니티 평점과 소장/위시리스트 수
DISCOGS_TOKEN=
# 선택: Last.fm 청취자 수(대중성)
LASTFM_API_KEY=
